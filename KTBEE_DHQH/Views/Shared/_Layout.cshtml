
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - Apple Store</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        body {
            padding-top: 0;
            background: #f5f5f7;
        }

        .shop-navbar {
            background: #1d1d1f;
            color: white;
            min-height: 60px;
            border: none;
            border-radius: 0;
            margin: 0;
        }

            .shop-navbar .container {
                padding-top: 5px;
            }

            .shop-navbar .navbar-brand {
                color: white;
                font-weight: bold;
                font-size: 22px;
            }

            .shop-navbar .navbar-nav > li > a {
                color: #eee;
                padding-top: 20px;
                padding-bottom: 20px;
            }

                .shop-navbar .navbar-nav > li > a:hover {
                    color: white;
                    background: #38383a;
                }

        .shop-footer {
            background: #1d1d1f;
            color: #aaa;
            text-align: center;
            padding: 30px 15px;
            margin-top: 30px;
        }

        .body-content {
            width: 100%;
            padding: 0;
            margin: 0;
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-inverse shop-navbar">
        <div class="container">

            <div class="navbar-header">

                <button type="button"
                        class="navbar-toggle collapsed"
                        data-toggle="collapse"
                        data-target="#shopMenu">

                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>

                @Html.ActionLink(
                    " Apple Store",
                    "Index",
                    "Home",
                    new { area = "" },
                    new { @class = "navbar-brand" }
                )
            </div>

            <div class="collapse navbar-collapse" id="shopMenu">

                <ul class="nav navbar-nav navbar-right">

                    <li>
                        @Html.ActionLink("Trang chủ", "Index", "Home",
                            new { area = "" }, null)
                    </li>

                    <li>
                        <a href="@Url.Action("Index", "Home")#sanpham">
                            Sản phẩm
                        </a>
                    </li>


                    <li>
                        <a href="@Url.Action("Index", "Cart")">
                            <span class="glyphicon glyphicon-shopping-cart"></span>
                            Giỏ hàng
                        </a>
                    </li>

                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                            Tài khoản <span class="caret"></span>
                        </a>

                        <ul class="dropdown-menu">
                            <li>
                                @Html.ActionLink(
                                    "Lịch sử mua hàng",
                                    "Index",
                                    "MyOrder",
                                    new { area = "" },
                                    null
                                )
                            </li>
                        </ul>
                    </li>

                </ul>
            </div>

        </div>
    </nav>

    <div class="body-content">
        @RenderBody()
    </div>

    <footer class="shop-footer">
        <h4> Apple Store</h4>
        <p>Khám phá công nghệ - Nâng tầm trải nghiệm</p>
        <p>© @DateTime.Now.Year Apple Store. All rights reserved.</p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>
</html>
