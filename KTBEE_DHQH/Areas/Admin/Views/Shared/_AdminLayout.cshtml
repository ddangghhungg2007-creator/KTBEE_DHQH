<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - Admin</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f9;
        }

        .admin-header {
            height: 65px;
            background: #212529;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

            .admin-header h4 {
                margin: 0;
            }

        .admin-container {
            display: flex;
            min-height: calc(100vh - 65px);
        }

        .admin-sidebar {
            width: 240px;
            background: #343a40;
            padding: 20px 0;
        }

            .admin-sidebar a {
                display: block;
                padding: 14px 25px;
                color: white;
                text-decoration: none;
            }

                .admin-sidebar a:hover {
                    background: #495057;
                }

        .admin-content {
            flex: 1;
            padding: 30px;
            min-width: 0;
        }

        .admin-card {
            background: white;
            padding: 22px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
        }

        .table th {
            white-space: nowrap;
        }

        @@media (max-width: 768px) {
            .admin-container {
                display: block;
            }

            .admin-sidebar {
                width: 100%;
            }

            .admin-content {
                padding: 15px;
            }
        }
    </style>
</head>

<body>

    <header class="admin-header">
        <h4>ADMIN PANEL</h4>

        <div style="display:flex; align-items:center; gap:15px;">
            <span>
                Tài khoản: <strong>@Session["AdminUsername"]</strong>
            </span>

            @using (Html.BeginForm("Logout", "Account",
                new { area = "Admin" }, FormMethod.Post,
                new { style = "margin:0;" }))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger btn-sm">
                    Đăng xuất
                </button>
            }
        </div>
    </header>

    <div class="admin-container">

        <aside class="admin-sidebar">
            <a href="@Url.Action("Index", "Home", new { area = "Admin" })">
                Trang tổng quan
            </a>

            <a href="@Url.Action("Index", "Products", new { area = "Admin" })">
                Quản lý sản phẩm
            </a>

            <a href="@Url.Action("Index", "Orders", new { area = "Admin" })">
                Quản lý đơn hàng
            </a>

            <a href="@Url.Action("Index", "Home", new { area = "" })">
                Về trang chủ
            </a>
        </aside>

        <main class="admin-content">
            @RenderBody()
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)

</body>
</html>
